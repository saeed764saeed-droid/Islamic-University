rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasRole(roleName) {
      return signedIn()
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == roleName;
    }
    function roleDoc() { return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data; }
    function isSuperAdmin() { return hasRole('superadmin'); }
    function isAdmin() { return hasRole('admin'); }
    function isSectionAdmin() { return hasRole('sectionAdmin'); }
    function isUploader() { return hasRole('uploader'); }
    function isGlobalAdmin() { return isSuperAdmin() || isAdmin(); }
    function canReviewSection(section) {
      return isSectionAdmin() && roleDoc().sectionKeys is list && roleDoc().sectionKeys.hasAny([section]);
    }
    function canUploadTo(section, folder) {
      return isGlobalAdmin()
        || (isSectionAdmin() && roleDoc().sectionKeys is list && roleDoc().sectionKeys.hasAny([section]))
        || (isUploader() && roleDoc().folderKeys is list && roleDoc().folderKeys.hasAny([section + '::' + folder]));
    }

    match /userRoles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isGlobalAdmin());
      allow list: if isGlobalAdmin();
      // رولونه یوازې Cloud Functions/Admin SDK ټاکي؛ اپلېکېشن یې مستقیم نه شي بدلولی.
      allow create, update, delete: if false;
    }

    match /mediaAssets/{mediaId} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && (resource.data.ownerUid == request.auth.uid || isGlobalAdmin()
          || canReviewSection(resource.data.section)));
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.mediaId == mediaId
        && request.resource.data.section is string
        && request.resource.data.folder is string
        && request.resource.data.fileName is string
        && request.resource.data.storagePath == 'pending/' + request.auth.uid + '/' + mediaId + '/' + request.resource.data.fileName
        && request.resource.data.size is int
        && request.resource.data.size >= 0
        && request.resource.data.size <= 100 * 1024 * 1024
        && canUploadTo(request.resource.data.section, request.resource.data.folder)
        && request.resource.data.status == 'pending'
        && (isGlobalAdmin() || isSectionAdmin() || isUploader());
      allow update: if isGlobalAdmin();
      allow delete: if isGlobalAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid && resource.data.status == 'pending');
    }

    match /pendingLessons/{lessonId} {
      allow read: if isGlobalAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || canReviewSection(resource.data.section);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.section is string
        && request.resource.data.folder is string
        && canUploadTo(request.resource.data.section, request.resource.data.folder)
        && (isGlobalAdmin() || isSectionAdmin() || isUploader());
      // ټول بدلونونه د خوندي Cloud Function له لارې کېږي.
      allow update, delete: if false;
    }

    match /publishedLessons/{lessonId} {
      allow read: if true;
      allow write: if false;
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isGlobalAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isGlobalAdmin();
      allow write: if false;
    }

    match /library_sync_v1/{document=**} {
      allow read, write: if isGlobalAdmin();
    }

    match /system/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
