rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasRole(roleName) {
      return signedIn()
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        && (get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.active == true
          || (get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'superadmin'
            && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.active != false))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == roleName;
    }
    function roleDoc() { return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data; }
    function isSuperAdmin() { return hasRole('superadmin'); }
    function isAdmin() { return hasRole('admin'); }
    function isSectionAdmin() { return hasRole('sectionAdmin'); }
    function isUploader() { return hasRole('uploader'); }
    function isGlobalAdmin() { return isSuperAdmin() || isAdmin(); }
    function hasPermission(permission) {
      let data = signedIn() && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) ? roleDoc() : {};
      let custom = data.permissions is map && permission in data.permissions;
      return isSuperAdmin() || (signedIn() && (custom
        ? data.permissions[permission] == true
        : (data.role == 'admin' && ['upload','createContent','editContent','deleteContent','publish','manageLibrary','editSettings','viewAudit','review'].hasAny([permission]))
          || (data.role == 'sectionAdmin' && ['upload','createContent','editContent','review'].hasAny([permission]))
          || (data.role == 'uploader' && ['upload','createContent'].hasAny([permission]))));
    }
    function canEditIn(section, folder) {
      return hasPermission('editContent') && (isSuperAdmin() || isAdmin()
        || (roleDoc().sectionKeys is list && roleDoc().sectionKeys.hasAny([section]))
        || (roleDoc().folderKeys is list && roleDoc().folderKeys.hasAny([section + '::' + folder]))
        || (roleDoc().sectionKeys is list && roleDoc().sectionKeys.size() == 0
          && roleDoc().folderKeys is list && roleDoc().folderKeys.size() == 0));
    }
    function canReviewSection(section) {
      return hasPermission('review') && roleDoc().sectionKeys is list && roleDoc().sectionKeys.hasAny([section]);
    }
    function canUploadTo(section, folder) {
      return isSuperAdmin()
        || (hasPermission('upload') && isAdmin())
        || (hasPermission('upload') && roleDoc().sectionKeys is list && roleDoc().sectionKeys.hasAny([section]))
        || (hasPermission('upload') && roleDoc().folderKeys is list && roleDoc().folderKeys.hasAny([section + '::' + folder]));
    }

    match /userRoles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      // رولونه یوازې Cloud Functions/Admin SDK ټاکي؛ اپلېکېشن یې مستقیم نه شي بدلولی.
      allow create, update, delete: if false;
    }

    match /mediaAssets/{mediaId} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && (resource.data.ownerUid == request.auth.uid
          || (hasPermission('review') && (isGlobalAdmin() || canReviewSection(resource.data.section)))));
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.mediaId == mediaId
        && request.resource.data.section is string
        && request.resource.data.folder is string
        && request.resource.data.fileName is string
        && request.resource.data.storagePath == 'pending/' + request.auth.uid + '/' + mediaId + '/' + request.resource.data.fileName
        && request.resource.data.size is int
        && request.resource.data.size >= 0
        && request.resource.data.size <= 100 * 1024 * 1024
        && canUploadTo(request.resource.data.section, request.resource.data.folder)
        && request.resource.data.status == 'pending'
        && (isSuperAdmin() || (hasPermission('upload') && (hasPermission('createContent')
          || (hasPermission('editContent') && exists(/databases/$(database)/documents/publishedLessons/$(request.resource.data.itemId))))));
      allow update: if false;
      allow delete: if hasPermission('deleteContent')
        || (signedIn() && resource.data.ownerUid == request.auth.uid && resource.data.status == 'pending');
    }

    match /pendingLessons/{lessonId} {
      allow read: if (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (hasPermission('review') && (isGlobalAdmin() || canReviewSection(resource.data.section)));
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.section is string
        && request.resource.data.folder is string
        && (canUploadTo(request.resource.data.section, request.resource.data.folder) || canEditIn(request.resource.data.section, request.resource.data.folder))
        && (isSuperAdmin() || (hasPermission('upload') && hasPermission('createContent')) || hasPermission('editContent'));
      // ټول بدلونونه د خوندي Cloud Function له لارې کېږي.
      allow update, delete: if false;
    }

    match /publishedLessons/{lessonId} {
      allow read: if true;
      allow write: if false;
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if hasPermission('manageLibrary') || hasPermission('editSettings') || hasPermission('editContent');
    }

    match /auditLogs/{logId} {
      allow read: if hasPermission('viewAudit');
      allow write: if false;
    }

    match /library_sync_v1/{document=**} {
      allow read, write: if hasPermission('manageLibrary');
    }

    match /system/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
